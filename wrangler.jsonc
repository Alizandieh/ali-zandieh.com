{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ali-zandieh",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "ali-zandieh.com", "custom_domain": true }
  ]
}
